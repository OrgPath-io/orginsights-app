# Copy to .env and fill in your values
# (Replit: use the Secrets panel instead)

# Server
PORT=5000

# Database (SQLite file path)
DATABASE_PATH=./data/app.db

# Blob storage (uploaded files)
BLOB_DIR=./data/blobs

# SMTP for transactional emails (AuthSMTP)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@orginsights.io
SMTP_FROM_NAME=OrgInsights

# Chromium for PDF generation (auto-detected if not set)
# CHROME_PATH=/usr/bin/chromium
